<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="CombatChecks.cs" />
    <Compile Include="MultipleSpawnChecks.cs" />
    <Compile Include="RouteOracleChecks.cs" />
    <Compile Include="WorkflowChecks.cs" />
    <Compile Include="LayoutReviewChecks.cs" />
    <Compile Include="SimulationLayoutChecks.cs" />
    <Compile Include="../Assets/Scripts/Simulation/SimulationLayout.cs" Link="Simulation/SimulationLayout.cs" />
    <Compile Include="PlainBackgroundChecks.cs" />
    <Compile Include="ScanReplay.cs" />
    <Compile Include="ScanRejectionChecks.cs" />
    <None Include="Fixtures/real-unmarked-bricks-v1.rgb.gz" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/real-cropped-bricks-v1.rgb.gz" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Assets/Scripts/Domain/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../Assets/Scripts/Contracts/*.cs" />
    <Compile Include="../Assets/Scripts/Application/*.cs" />
    <Compile Include="../Assets/Scripts/Vision/*.cs" Link="Vision/%(Filename)%(Extension)" />
    <Compile Include="../Assets/ThirdParty/RoyTAStar/MinHeap.cs" Link="ThirdParty/MinHeap.cs" />
    <Compile Include="../Assets/ThirdParty/Colourful/*.cs" Link="ThirdParty/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
