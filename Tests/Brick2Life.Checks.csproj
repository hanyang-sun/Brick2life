<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="SimulationLayoutChecks.cs" />
    <Compile Include="BoardContractChecks.cs" />
    <Compile Include="BoardSyncChecks.cs" />
    <Compile Include="DatasetPlanChecks.cs" />
    <Compile Include="LevelSemanticsChecks.cs" />
    <Compile Include="ProjectionPlanChecks.cs" />
    <Compile Include="LevelFeedbackChecks.cs" />
    <Compile Include="VisionChecks.cs" />
    <Compile Include="BattleChecks.cs" />
    <Compile Include="LiveBattleChecks.cs" />
    <Compile Include="GeneratedRoundChecks.cs" />
    <Compile Include="GeneratedBattleFallbackChecks.cs" />
    <Compile Include="../Assets/Scripts/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Assets/Scripts/Application/**/*.cs" Link="Application/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Assets/Scripts/Vision/**/*.cs" Link="Vision/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Assets/Scripts/Battle/**/*.cs" Link="Battle/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
